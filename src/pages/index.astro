---
import DailyTodo from "../components/DailyTodo";
import { themeBootScript } from "@studio-baeks/paper-ui/theme-boot";
import { FONT_STYLESHEETS } from "@studio-baeks/paper-ui/tokens";
import "../styles/global.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <script is:inline set:html={themeBootScript({ defaultTheme: "system" })} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f9f9f9" />
    <meta name="description" content="오늘의 할 일과 시간별 루틴 체크포인트를 한 장에 담아보세요." />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Daily" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href={FONT_STYLESHEETS.sans} />
    <link rel="stylesheet" href={FONT_STYLESHEETS.mono} />
    <title>Daily Todo</title>
  </head>
  <body>
    <DailyTodo client:only="react" />
    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          void navigator.serviceWorker.register("/sw.js");
        }, { once: true });
      }
    </script>
  </body>
</html>
